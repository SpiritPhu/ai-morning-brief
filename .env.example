# =============================================================================
# AI Morning Brief — copy to .env and fill secrets (DO NOT commit .env)
# Hướng dẫn deploy server: docs/DEPLOY.md
# =============================================================================

# --- Database ---
# Docker Compose (khuyến nghị trên server):
DATABASE_URL=postgresql+psycopg://brief:brief@db:5432/brief
# Local test không Docker (SQLite):
# DATABASE_URL=sqlite:///./data/brief.db

TZ=Asia/Ho_Chi_Minh

# --- LLM (OpenAI-compatible) ---
# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
#
# Gemini:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_MAX_ITEMS_PER_DAY=30

# --- Embeddings ---
# Máy yếu / server nhỏ:
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
# Máy mạnh (cần khớp dim khi tạo DB):
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIM=1024

# --- API tokens ---
GITHUB_TOKEN=
HF_TOKEN=
REDDIT_USER_AGENT=ai-morning-brief/0.1 (by your_name)
USER_AGENT=ai-morning-brief/0.1 (+https://github.com/SpiritPhu/ai-morning-brief)

# --- Schedule (Asia/Ho_Chi_Minh) ---
BRIEF_SCHEDULE_HOUR=6
BRIEF_SCHEDULE_MINUTE=0

# --- Notify (optional) ---
TEAMS_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# Public URL of dashboard (for notify links)
DASHBOARD_URL=http://localhost:8501
